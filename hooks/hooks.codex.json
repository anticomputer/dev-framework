{
  "description": "dev-framework lifecycle enforcement for Codex CLI",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "DF_HOST=codex bash \"$PLUGIN_ROOT/hooks/lib/session-start.sh\"",
            "timeout": 20,
            "statusMessage": "dev-framework: loading the constitution"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "DF_HOST=codex bash \"$PLUGIN_ROOT/hooks/lib/pre-tool-use.sh\"",
            "timeout": 20,
            "statusMessage": "dev-framework: checking protected paths"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "DF_HOST=codex bash \"$PLUGIN_ROOT/hooks/lib/post-tool-use.sh\"",
            "timeout": 120,
            "statusMessage": "dev-framework: format + lint"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "DF_HOST=codex bash \"$PLUGIN_ROOT/hooks/lib/stop-gate.sh\"",
            "timeout": 600,
            "statusMessage": "dev-framework: completion gate"
          }
        ]
      }
    ]
  }
}
